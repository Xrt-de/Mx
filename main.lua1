    clearContent()
    makeHeading("ESP SETTINGS")
    espButton = makeButton(
        content,
        "ESP  [OFF]",
        UDim2.new(0, 0, 0, 40),
        UDim2.new(1, 0, 0, 38)
    )
    espButton.MouseButton1Click:Connect(function()
        setESP(not ESPEnabled)
        updateESPButton()
    end)
    updateESPButton()

    local tracerColorButton = makeButton(
        content,
        "Tracer Color: " .. COLOR_OPTIONS[tracerColorIndex].name,
        UDim2.new(0, 0, 0, 88),
        UDim2.new(1, 0, 0, 34)
    )
    tracerColorButton.MouseButton1Click:Connect(function()
        tracerColorIndex = (tracerColorIndex % #COLOR_OPTIONS) + 1
        tracerColorButton.Text = "Tracer Color: " .. COLOR_OPTIONS[tracerColorIndex].name
        tracerColorButton.TextColor3 = getTracerColor()
        refreshTracerColors()
    end)
    tracerColorButton.TextColor3 = getTracerColor()

    local playerColorButton = makeButton(
        content,
        "Player Outline: " .. COLOR_OPTIONS[playerColorIndex].name,
        UDim2.new(0, 0, 0, 128),
        UDim2.new(1, 0, 0, 34)
    )
    playerColorButton.MouseButton1Click:Connect(function()
        playerColorIndex = (playerColorIndex % #COLOR_OPTIONS) + 1
        playerColorButton.Text = "Player Outline: " .. COLOR_OPTIONS[playerColorIndex].name
        playerColorButton.TextColor3 = getPlayerColor()
        refreshPlayerOutlineColors()
        if ESPEnabled then
            scanPlayers()
        end
    end)
    playerColorButton.TextColor3 = getPlayerColor()

    local info = Instance.new("TextLabel")
    info.Position = UDim2.new(0, 0, 0, 170)
    info.Size = UDim2.new(1, 0, 0, 58)
    info.BackgroundTransparency = 1
    info.Text = "Click color buttons to cycle colors.\nOrange: NPC Dummies"
    info.TextColor3 = Color3.fromRGB(175, 175, 190)
    info.Font = Enum.Font.Gotham
    info.TextSize = 13
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextWrapped = true
    info.Parent = content
end

local aimButton
local targetPartButton
local TARGET_PARTS = {"Head", "Torso", "Legs"}
local targetPartIndex = 1

local function getSelectedTargetPosition(character)
    if not character then
        return nil
    end
    local selected = TARGET_PARTS[targetPartIndex]
    if selected == "Head" then
        local head = character:FindFirstChild("Head")
        return head and head.Position or nil
    elseif selected == "Torso" then
        local torso = character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
        return torso and torso.Position or nil
    else
        local leftLeg = character:FindFirstChild("LeftLowerLeg")
            or character:FindFirstChild("Left Leg")
        local rightLeg = character:FindFirstChild("RightLowerLeg")
            or character:FindFirstChild("Right Leg")
        if leftLeg and rightLeg then
            return (leftLeg.Position + rightLeg.Position) / 2
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        return root and (root.Position - Vector3.new(0, 2, 0)) or nil
    end
end

local function getClosestAimTarget()
    local camera = Workspace.CurrentCamera
    if not camera then
        return nil
    end
    local viewportCenter = camera.ViewportSize / 2
    local closestPosition = nil
    local closestDistance = AIM_RADIUS
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local targetPosition = getSelectedTargetPosition(character)
            if humanoid and humanoid.Health > 0 and targetPosition then
                local screenPoint, onScreen = camera:WorldToViewportPoint(targetPosition)
                if onScreen and screenPoint.Z > 0 then
                    local screenPosition = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (screenPosition - viewportCenter).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPosition = targetPosition
                    end
                end
            end
        end
    end
    return closestPosition
end

local function updateTargetPartButton()
    if targetPartButton then
        targetPartButton.Text = "TARGET PART: " .. TARGET_PARTS[targetPartIndex] .. "  [CHANGE]"
    end
end

local function updateAimButton()
    if not aimButton then
        return
    end
    if AimAssistEnabled then
        aimButton.Text = "AIM ASSIST  [ON]"
        aimButton.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
    else
        aimButton.Text = "AIM ASSIST  [OFF]"
        aimButton.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    end
end

local function showAimPage()
    clearContent()
    makeHeading("AIM ASSIST")
    aimButton = makeButton(
        content,
        "AIM ASSIST  [OFF]",
        UDim2.new(0, 0, 0, 40),
        UDim2.new(1, 0, 0, 38)
    )
    aimButton.MouseButton1Click:Connect(function()
        AimAssistEnabled = not AimAssistEnabled
        updateAimButton()
    end)
    updateAimButton()

    targetPartButton = makeButton(
        content,
        "TARGET PART: Head  [CHANGE]",
        UDim2.new(0, 0, 0, 88),
        UDim2.new(1, 0, 0, 34)
    )
    targetPartButton.MouseButton1Click:Connect(function()
        targetPartIndex = (targetPartIndex % #TARGET_PARTS) + 1
        updateTargetPartButton()
    end)
    updateTargetPartButton()

    local speedHeading = Instance.new("TextLabel")
    speedHeading.Position = UDim2.new(0, 0, 0, 136)
    speedHeading.Size = UDim2.new(1, 0, 0, 24)
    speedHeading.BackgroundTransparency = 1
    speedHeading.Text = "AIM SPEED"
    speedHeading.TextColor3 = Color3.fromRGB(230, 230, 240)
    speedHeading.Font = Enum.Font.GothamMedium
    speedHeading.TextSize = 13
    speedHeading.TextXAlignment = Enum.TextXAlignment.Left
    speedHeading.Parent = content

    local speedValueLabel = Instance.new("TextLabel")
    speedValueLabel.Position = UDim2.new(1, -48, 0, 136)
    speedValueLabel.Size = UDim2.new(0, 48, 0, 24)
    speedValueLabel.BackgroundTransparency = 1
    speedValueLabel.Text = tostring(AIM_SPEED)
    speedValueLabel.TextColor3 = Color3.fromRGB(110, 150, 255)
    speedValueLabel.Font = Enum.Font.GothamBold
    speedValueLabel.TextSize = 13
    speedValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    speedValueLabel.Parent = content

    local sliderTrack = Instance.new("Frame")
    sliderTrack.Name = "AimSpeedTrack"
    sliderTrack.Position = UDim2.new(0, 0, 0, 168)
    sliderTrack.Size = UDim2.new(1, 0, 0, 10)
    sliderTrack.BackgroundColor3 = Color3.fromRGB(48, 48, 64)
    sliderTrack.BorderSizePixel = 0
    sliderTrack.Parent = content
    addCorner(sliderTrack, 5)

    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "Fill"
    sliderFill.Size = UDim2.new((AIM_SPEED - 1) / 99, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(80, 130, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderTrack
    addCorner(sliderFill, 5)

    local sliderKnob = Instance.new("Frame")
    sliderKnob.Name = "Knob"
    sliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
    sliderKnob.Size = UDim2.new(0, 18, 0, 18)
    sliderKnob.Position = UDim2.new((AIM_SPEED - 1) / 99, 0, 0.5, 0)
    sliderKnob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
    sliderKnob.BorderSizePixel = 0
    sliderKnob.Parent = sliderTrack
    addCorner(sliderKnob, 9)

    local draggingSlider = false

    local function setSpeedFromX(x)
        local width = sliderTrack.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local relative = math.clamp(
            (x - sliderTrack.AbsolutePosition.X) / width,
            0,
            1
        )
        AIM_SPEED = math.clamp(math.floor(1 + relative * 99 + 0.5), 1, 100)
        local alpha = (AIM_SPEED - 1) / 99
        sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
        sliderKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
        speedValueLabel.Text = tostring(AIM_SPEED)
    end

    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            setSpeedFromX(input.Position.X)
        end
    end)

    table.insert(connections, UIS.InputChanged:Connect(function(input)
        if draggingSlider and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setSpeedFromX(input.Position.X)
        end
    end))

    table.insert(connections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end))

    local info = Instance.new("TextLabel")
    info.Position = UDim2.new(0, 0, 0, 190)
    info.Size = UDim2.new(1, 0, 0, 52)
    info.BackgroundTransparency = 1
    info.Text = "1 = slow smooth tracking\n100 = very fast snap/flick\nAim point follows selected Head / Torso / Legs."
    info.TextColor3 = Color3.fromRGB(175, 175, 190)
    info.Font = Enum.Font.Gotham
    info.TextSize = 13
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextWrapped = true
    info.Parent = content
end

