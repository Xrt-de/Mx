-- AXIOM NETWORK PANEL
-- LocalScript | StarterPlayerScripts

local Players = game:GetService("Players")
local Stats = game:GetService("Stats")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "AxiomNetworkPanel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(230, 115)
frame.Position = UDim2.new(0, 25, 0.5, -60)
frame.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
frame.BorderSizePixel = 0
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius =
    UDim.new(0, 12)

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(65, 105, 255)
stroke.Thickness = 1.5
stroke.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 32)
title.Position = UDim2.fromOffset(10, 8)
title.BackgroundTransparency = 1
title.Text = "AXIOM  /  NETWORK"
title.TextColor3 = Color3.fromRGB(120, 155, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 13
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local pingLabel = Instance.new("TextLabel")
pingLabel.Size = UDim2.new(1, -20, 0, 28)
pingLabel.Position = UDim2.fromOffset(10, 43)
pingLabel.BackgroundTransparency = 1
pingLabel.Text = "PING: -- ms"
pingLabel.TextColor3 = Color3.new(1, 1, 1)
pingLabel.Font = Enum.Font.GothamMedium
pingLabel.TextSize = 16
pingLabel.TextXAlignment = Enum.TextXAlignment.Left
pingLabel.Parent = frame

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 0, 22)
statusLabel.Position = UDim2.fromOffset(10, 76)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "STATUS: CONNECTED"
statusLabel.TextColor3 = Color3.fromRGB(90, 220, 140)
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextSize = 12
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.Parent = frame

task.spawn(function()
    while gui.Parent do
        local success, ping = pcall(function()
            return Stats.Network.ServerStatsItem[
                "Data Ping"
            ]:GetValue()
        end)

        if success and ping then
            pingLabel.Text = string.format(
                "PING: %d ms",
                math.floor(ping)
            )

            if ping < 100 then
                statusLabel.Text = "STATUS: STABLE"
                statusLabel.TextColor3 =
                    Color3.fromRGB(90, 220, 140)
            elseif ping < 200 then
                statusLabel.Text = "STATUS: MODERATE"
                statusLabel.TextColor3 =
                    Color3.fromRGB(255, 190, 70)
            else
                statusLabel.Text = "STATUS: HIGH LATENCY"
                statusLabel.TextColor3 =
                    Color3.fromRGB(255, 90, 90)
            end
        else
            statusLabel.Text = "STATUS: UNAVAILABLE"
        end

        task.wait(1)
    end
end)
