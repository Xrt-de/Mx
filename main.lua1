-- MX HUB v1.1
-- Roblox Studio LocalScript
-- Unified GUI + Player/NPC Outline ESP + Player Tracers
-- Place in StarterPlayer > StarterPlayerScripts in your own Studio experience.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- SETTINGS
local ESPEnabled = false
local AimAssistEnabled = false
local AIM_SPEED = 50 -- 1 = slow, 100 = very fast
local AIM_RADIUS = 180
local DUMMY_COLOR = Color3.fromRGB(255, 170, 60)

local COLOR_OPTIONS = {
    {name = "Cyan", color = Color3.fromRGB(0, 255, 255)},
    {name = "Blue", color = Color3.fromRGB(50, 120, 255)},
    {name = "White", color = Color3.fromRGB(255, 255, 255)},
    {name = "Grey", color = Color3.fromRGB(145, 145, 155)},
    {name = "Black", color = Color3.fromRGB(20, 20, 20)},
    {name = "Red", color = Color3.fromRGB(255, 55, 55)},
    {name = "Green", color = Color3.fromRGB(55, 220, 95)},
    {name = "Yellow", color = Color3.fromRGB(255, 230, 40)},
    {name = "Pink", color = Color3.fromRGB(255, 105, 180)},
    {name = "Lavender", color = Color3.fromRGB(180, 140, 255)},
    {name = "Orange", color = Color3.fromRGB(255, 150, 40)}
}

local tracerColorIndex = 2
local playerColorIndex = 2

local function getTracerColor()
    return COLOR_OPTIONS[tracerColorIndex].color
end

local function getPlayerColor()
    return COLOR_OPTIONS[playerColorIndex].color
end

local highlights = {}
local tracers = {}
local connections = {}

-- CLEAN UP OLD GUI
local oldGui = PlayerGui:FindFirstChild("MXHub")
if oldGui then
    oldGui:Destroy()
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "MXHub"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = PlayerGui

local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.new(0, 440, 0, 320)
main.Position = UDim2.new(0.5, -220, 0.5, -160)
main.BackgroundColor3 = Color3.fromRGB(19, 19, 27)
main.BorderSizePixel = 0
main.Parent = gui

local function addCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = object
end

addCorner(main, 12)

-- HEADER
local header = Instance.new("Frame")
header.Size = UDim2.new(1, 0, 0, 48)
header.BackgroundColor3 = Color3.fromRGB(29, 29, 41)
header.BorderSizePixel = 0
header.Parent = main
addCorner(header, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -60, 1, 0)
title.Position = UDim2.new(0, 16, 0, 0)
title.BackgroundTransparency = 1
title.Text = "MX HUB"
title.TextColor3 = Color3.fromRGB(110, 150, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 21
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = header

local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 34, 0, 30)
closeButton.Position = UDim2.new(1, -42, 0, 9)
closeButton.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
closeButton.Text = "X"
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.Font = Enum.Font.GothamBold
closeButton.TextSize = 14
closeButton.Parent = header
addCorner(closeButton, 7)

-- SIDEBAR
local sidebar = Instance.new("Frame")
sidebar.Position = UDim2.new(0, 10, 0, 60)
sidebar.Size = UDim2.new(0, 115, 1, -70)
sidebar.BackgroundTransparency = 1
sidebar.Parent = main

-- CONTENT
local content = Instance.new("Frame")
content.Position = UDim2.new(0, 135, 0, 60)
content.Size = UDim2.new(1, -145, 1, -70)
content.BackgroundTransparency = 1
content.Parent = main

-- GUI HELPERS
local function makeButton(parent, text, position, size)
    local button = Instance.new("TextButton")
    button.Position = position
    button.Size = size
    button.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(230, 230, 240)
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 14
    button.BorderSizePixel = 0
    button.AutoButtonColor = true
    button.Parent = parent
    addCorner(button, 7)
    return button
end

local function clearContent()
    for _, item in ipairs(content:GetChildren()) do
        item:Destroy()
    end
end

local function makeHeading(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 32)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 18
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = content
    return label
end

-- ESP HELPERS
local function isPlayerCharacter(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function isDummy(model)
    if not model:IsA("Model") or isPlayerCharacter(model) then
        return false
    end

    return model:FindFirstChildOfClass("Humanoid") ~= nil
        and model:FindFirstChild("HumanoidRootPart") ~= nil
end

local function createHighlight(model, color)
    if not model or not model.Parent then
        return
    end

    local existing = highlights[model]
    if existing and existing.Parent then
        existing.Enabled = ESPEnabled
        existing.OutlineColor = color
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MXHub_Outline"
    highlight.Adornee = model
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = ESPEnabled
    highlight.Parent = model

    highlights[model] = highlight
end

local function removeHighlight(model)
    local highlight = highlights[model]
    if highlight then
        highlight:Destroy()
        highlights[model] = nil
    end
end

local function updatePlayer(player)
    if player == LocalPlayer then
        return
    end

    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        createHighlight(character, getPlayerColor())
    end
end

local function scanPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        updatePlayer(player)
    end
end

local function scanDummies()
    for _, object in ipairs(Workspace:GetDescendants()) do
        if isDummy(object) then
            createHighlight(object, DUMMY_COLOR)
        end
    end
end

-- PLAYER TRACERS (players only; controlled by ESP toggle)
local function removeTracer(player)
    local data = tracers[player]
    if not data then
        return
    end

    if data.beam then
        data.beam:Destroy()
    end
    if data.targetAttachment then
        data.targetAttachment:Destroy()
    end

    tracers[player] = nil
end

local function createTracer(player)
    if player == LocalPlayer or not ESPEnabled then
        return
    end

    local myCharacter = LocalPlayer.Character
    local targetCharacter = player.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

    if not myRoot or not targetRoot then
        removeTracer(player)
        return
    end

    local current = tracers[player]
    if current and current.beam and current.beam.Parent then
        local sameRoots = current.beam.Attachment0
            and current.beam.Attachment0.Parent == myRoot
            and current.beam.Attachment1
            and current.beam.Attachment1.Parent == targetRoot

        if sameRoots then
            current.beam.Enabled = true
            return
        end

        removeTracer(player)
    end

    local startAttachment = myRoot:FindFirstChild("MXHubTracerStart")
    if not startAttachment then
        startAttachment = Instance.new("Attachment")
        startAttachment.Name = "MXHubTracerStart"
        startAttachment.Parent = myRoot
    end

    local targetAttachment = Instance.new("Attachment")
    targetAttachment.Name = "MXHubTracerEnd"
    targetAttachment.Parent = targetRoot

    local beam = Instance.new("Beam")
    beam.Name = "MXHubPlayerTracer"
    beam.Attachment0 = startAttachment
    beam.Attachment1 = targetAttachment
    beam.FaceCamera = true
    beam.Width0 = 0.08
    beam.Width1 = 0.04
    beam.Color = ColorSequence.new(getTracerColor())
    beam.Transparency = NumberSequence.new(0)
    beam.Enabled = true
    beam.Parent = Workspace

    tracers[player] = {
        beam = beam,
        targetAttachment = targetAttachment
    }
end

local function updateTracers()
    if not ESPEnabled then
        for _, data in pairs(tracers) do
            if data.beam then
                data.beam.Enabled = false
            end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createTracer(player)
        end
    end
end

local function refreshPlayerOutlineColors()
    for model, highlight in pairs(highlights) do
        if model and model.Parent and highlight and highlight.Parent
            and isPlayerCharacter(model) then
            highlight.OutlineColor = getPlayerColor()
        end
    end
end

local function refreshTracerColors()
    local selectedColor = getTracerColor()
    for _, data in pairs(tracers) do
        if data.beam and data.beam.Parent then
            data.beam.Color = ColorSequence.new(selectedColor)
        end
    end
end

local function setESP(state)
    ESPEnabled = state

    for model, highlight in pairs(highlights) do
        if model and model.Parent and highlight and highlight.Parent then
            highlight.Enabled = state
        else
            highlights[model] = nil
        end
    end

    updateTracers()

    if state then
        scanPlayers()
        scanDummies()
        updateTracers()
    end
end

-- ESP PAGE
local espButton

local function updateESPButton()
    if not espButton then
        return
    end

    if ESPEnabled then
        espButton.Text = "ESP  [ON]"
        espButton.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
    else
        espButton.Text = "ESP  [OFF]"
        espButton.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    end
end

local function showESPPage()
    clearContent()
    makeHeading("ESP SETTINGS")

    espButton = makeButton(
        content,
        "ESP  [OFF]",
        UDim2.new(0, 0, 0, 40),
        UDim2.new(1, 0, 0, 38)
    )

    espButton.MouseButton1Click:Connect(function()
        setESP(not ESPEnabled)
        updateESPButton()
    end)

    updateESPButton()

    local tracerColorButton = makeButton(
        content,
        "Tracer Color: " .. COLOR_OPTIONS[tracerColorIndex].name,
        UDim2.new(0, 0, 0, 88),
        UDim2.new(1, 0, 0, 34)
    )

    tracerColorButton.MouseButton1Click:Connect(function()
        tracerColorIndex = (tracerColorIndex % #COLOR_OPTIONS) + 1
        tracerColorButton.Text = "Tracer Color: " .. COLOR_OPTIONS[tracerColorIndex].name
        tracerColorButton.TextColor3 = getTracerColor()
        refreshTracerColors()
    end)
    tracerColorButton.TextColor3 = getTracerColor()

    local playerColorButton = makeButton(
        content,
        "Player Outline: " .. COLOR_OPTIONS[playerColorIndex].name,
        UDim2.new(0, 0, 0, 128),
        UDim2.new(1, 0, 0, 34)
    )

    playerColorButton.MouseButton1Click:Connect(function()
        playerColorIndex = (playerColorIndex % #COLOR_OPTIONS) + 1
        playerColorButton.Text = "Player Outline: " .. COLOR_OPTIONS[playerColorIndex].name
        playerColorButton.TextColor3 = getPlayerColor()
        refreshPlayerOutlineColors()
        if ESPEnabled then
            scanPlayers()
        end
    end)
    playerColorButton.TextColor3 = getPlayerColor()

    local info = Instance.new("TextLabel")
    info.Position = UDim2.new(0, 0, 0, 170)
    info.Size = UDim2.new(1, 0, 0, 58)
    info.BackgroundTransparency = 1
    info.Text = "Click color buttons to cycle colors.\\nOrange: NPC Dummies"
    info.TextColor3 = Color3.fromRGB(175, 175, 190)
    info.Font = Enum.Font.Gotham
    info.TextSize = 13
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextWrapped = true
    info.Parent = content
end

-- AIM ASSIST
-- Studio test-place camera training feature with a selectable body-part target.
local aimButton
local targetPartButton
local TARGET_PARTS = {"Head", "Torso", "Legs"}
local targetPartIndex = 1

local function getSelectedTargetPosition(character)
    if not character then
        return nil
    end

    local selected = TARGET_PARTS[targetPartIndex]

    if selected == "Head" then
        local head = character:FindFirstChild("Head")
        return head and head.Position or nil
    elseif selected == "Torso" then
        local torso = character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
        return torso and torso.Position or nil
    else
        -- R15: midpoint of lower legs; R6: midpoint of the two legs.
        local leftLeg = character:FindFirstChild("LeftLowerLeg")
            or character:FindFirstChild("Left Leg")
        local rightLeg = character:FindFirstChild("RightLowerLeg")
            or character:FindFirstChild("Right Leg")
        if leftLeg and rightLeg then
            return (leftLeg.Position + rightLeg.Position) / 2
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        return root and (root.Position - Vector3.new(0, 2, 0)) or nil
    end
end

local function getClosestAimTarget()
    local camera = Workspace.CurrentCamera
    if not camera then
        return nil
    end

    local viewportCenter = camera.ViewportSize / 2
    local closestPosition = nil
    local closestDistance = AIM_RADIUS

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local targetPosition = getSelectedTargetPosition(character)

            if humanoid and humanoid.Health > 0 and targetPosition then
                local screenPoint, onScreen = camera:WorldToViewportPoint(targetPosition)

                if onScreen and screenPoint.Z > 0 then
                    local screenPosition = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (screenPosition - viewportCenter).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closestPosition = targetPosition
                    end
                end
            end
        end
    end

    return closestPosition
end

local function updateTargetPartButton()
    if targetPartButton then
        targetPartButton.Text = "TARGET PART: " .. TARGET_PARTS[targetPartIndex] .. "  [CHANGE]"
    end
end

local function updateAimButton()
    if not aimButton then
        return
    end

    if AimAssistEnabled then
        aimButton.Text = "AIM ASSIST  [ON]"
        aimButton.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
    else
        aimButton.Text = "AIM ASSIST  [OFF]"
        aimButton.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    end
end

local function showAimPage()
    clearContent()
    makeHeading("AIM ASSIST")

    aimButton = makeButton(
        content,
        "AIM ASSIST  [OFF]",
        UDim2.new(0, 0, 0, 40),
        UDim2.new(1, 0, 0, 38)
    )

    aimButton.MouseButton1Click:Connect(function()
        AimAssistEnabled = not AimAssistEnabled
        updateAimButton()
    end)

    updateAimButton()

    targetPartButton = makeButton(
        content,
        "TARGET PART: Head  [CHANGE]",
        UDim2.new(0, 0, 0, 88),
        UDim2.new(1, 0, 0, 34)
    )
    targetPartButton.MouseButton1Click:Connect(function()
        targetPartIndex = (targetPartIndex % #TARGET_PARTS) + 1
        updateTargetPartButton()
    end)
    updateTargetPartButton()

    local speedHeading = Instance.new("TextLabel")
    speedHeading.Position = UDim2.new(0, 0, 0, 136)
    speedHeading.Size = UDim2.new(1, 0, 0, 24)
    speedHeading.BackgroundTransparency = 1
    speedHeading.Text = "AIM SPEED"
    speedHeading.TextColor3 = Color3.fromRGB(230, 230, 240)
    speedHeading.Font = Enum.Font.GothamMedium
    speedHeading.TextSize = 13
    speedHeading.TextXAlignment = Enum.TextXAlignment.Left
    speedHeading.Parent = content

    local speedValueLabel = Instance.new("TextLabel")
    speedValueLabel.Position = UDim2.new(1, -48, 0, 136)
    speedValueLabel.Size = UDim2.new(0, 48, 0, 24)
    speedValueLabel.BackgroundTransparency = 1
    speedValueLabel.Text = tostring(AIM_SPEED)
    speedValueLabel.TextColor3 = Color3.fromRGB(110, 150, 255)
    speedValueLabel.Font = Enum.Font.GothamBold
    speedValueLabel.TextSize = 13
    speedValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    speedValueLabel.Parent = content

    local sliderTrack = Instance.new("Frame")
    sliderTrack.Name = "AimSpeedTrack"
    sliderTrack.Position = UDim2.new(0, 0, 0, 168)
    sliderTrack.Size = UDim2.new(1, 0, 0, 10)
    sliderTrack.BackgroundColor3 = Color3.fromRGB(48, 48, 64)
    sliderTrack.BorderSizePixel = 0
    sliderTrack.Parent = content
    addCorner(sliderTrack, 5)

    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "Fill"
    sliderFill.Size = UDim2.new((AIM_SPEED - 1) / 99, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(80, 130, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderTrack
    addCorner(sliderFill, 5)

    local sliderKnob = Instance.new("Frame")
    sliderKnob.Name = "Knob"
    sliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
    sliderKnob.Size = UDim2.new(0, 18, 0, 18)
    sliderKnob.Position = UDim2.new((AIM_SPEED - 1) / 99, 0, 0.5, 0)
    sliderKnob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
    sliderKnob.BorderSizePixel = 0
    sliderKnob.Parent = sliderTrack
    addCorner(sliderKnob, 9)

    local draggingSlider = false

    local function setSpeedFromX(x)
        local width = sliderTrack.AbsoluteSize.X
        if width <= 0 then
            return
        end

        local relative = math.clamp(
            (x - sliderTrack.AbsolutePosition.X) / width,
            0,
            1
        )

        AIM_SPEED = math.clamp(math.floor(1 + relative * 99 + 0.5), 1, 100)
        local alpha = (AIM_SPEED - 1) / 99

        sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
        sliderKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
        speedValueLabel.Text = tostring(AIM_SPEED)
    end

    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            setSpeedFromX(input.Position.X)
        end
    end)

    table.insert(connections, UIS.InputChanged:Connect(function(input)
        if draggingSlider and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setSpeedFromX(input.Position.X)
        end
    end))

    table.insert(connections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end))

    local info = Instance.new("TextLabel")
    info.Position = UDim2.new(0, 0, 0, 148)
    info.Size = UDim2.new(1, 0, 0, 72)
    info.BackgroundTransparency = 1
    info.Text = "1 = slow smooth tracking\n100 = very fast snap/flick\nTarget point is fixed to character root."
    info.TextColor3 = Color3.fromRGB(175, 175, 190)
    info.Font = Enum.Font.Gotham
    info.TextSize = 13
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextWrapped = true
    info.Parent = content
end

-- TABS
local espTab = makeButton(
    sidebar, "ESP",
    UDim2.new(0, 0, 0, 0),
    UDim2.new(1, 0, 0, 40)
)

local aimTab = makeButton(
    sidebar, "AIM",
    UDim2.new(0, 0, 0, 48),
    UDim2.new(1, 0, 0, 40)
)

espTab.MouseButton1Click:Connect(showESPPage)
aimTab.MouseButton1Click:Connect(showAimPage)

-- DRAGGING
local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- CLOSE / CLEANUP
local function cleanup()
    ESPEnabled = false

    for model, highlight in pairs(highlights) do
        if highlight then
            highlight:Destroy()
        end
        highlights[model] = nil
    end

    for player in pairs(tracers) do
        removeTracer(player)
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)
end

-- MINIMIZE / RESTORE
-- X hides the main hub and shows a small MX button to reopen it.
local restoreButton = Instance.new("TextButton")
restoreButton.Name = "MXHubRestore"
restoreButton.Size = UDim2.new(0, 54, 0, 38)
restoreButton.Position = UDim2.new(0, 16, 0.5, -19)
restoreButton.BackgroundColor3 = Color3.fromRGB(29, 29, 41)
restoreButton.Text = "MX"
restoreButton.TextColor3 = Color3.fromRGB(110, 150, 255)
restoreButton.Font = Enum.Font.GothamBold
restoreButton.TextSize = 16
restoreButton.BorderSizePixel = 0
restoreButton.Visible = false
restoreButton.Parent = gui
addCorner(restoreButton, 9)

closeButton.Text = "X"
closeButton.MouseButton1Click:Connect(function()
    main.Visible = false
    restoreButton.Visible = true
end)

restoreButton.MouseButton1Click:Connect(function()
    restoreButton.Visible = false
    main.Visible = true
end)

-- PLAYER EVENTS
local function connectPlayer(player)
    table.insert(connections, player.CharacterAdded:Connect(function(character)
        character:WaitForChild("HumanoidRootPart", 10)

        if ESPEnabled then
            updatePlayer(player)
            updateTracers()
        end
    end))

    if player.Character and ESPEnabled then
        updatePlayer(player)
    end
end

table.insert(connections, Players.PlayerAdded:Connect(connectPlayer))

table.insert(connections, Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        removeHighlight(player.Character)
    end
    removeTracer(player)
end))

for _, player in ipairs(Players:GetPlayers()) do
    connectPlayer(player)
end

-- INITIAL PAGE
showESPPage()

-- REFRESH LOOP
task.spawn(function()
    while gui.Parent do
        task.wait(2)
        if ESPEnabled then
            scanPlayers()
            scanDummies()
            updateTracers()
        end
    end
end)

table.insert(connections, game:GetService("RunService").RenderStepped:Connect(function()
    if not AimAssistEnabled then
        return
    end

    local camera = Workspace.CurrentCamera
    local targetPosition = getClosestAimTarget()

    if camera and targetPosition then
        local desiredCFrame = CFrame.lookAt(camera.CFrame.Position, targetPosition)
        local alpha = 1 - math.pow(1 - (AIM_SPEED / 100), 2)
        camera.CFrame = camera.CFrame:Lerp(desiredCFrame, alpha)
    end
end))

print("MX Hub v1.6 loaded successfully")
