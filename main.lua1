)

espTab.MouseButton1Click:Connect(showESPPage)
aimTab.MouseButton1Click:Connect(showAimPage)

local dragging = false
local dragStart
local startPosition

-- ============================================================
-- MOVEMENT CONTROLS (MX Hub v1.8 module, integrated in this file)
-- ============================================================

do
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local UserInputService = UIS

    local character, humanoid, root
    local flying, noclip = false, false
    local ascend, descend = false, false
    local flySpeed, walkSpeed = 40, 16
    local flyVelocity, flyConnection, noclipConnection
    local originalWalkSpeed = 16
    local savedCollision = {}

    local oldMovementGui = playerGui:FindFirstChild("MXMovementDev")
    if oldMovementGui then
        oldMovementGui:Destroy()
    end

    local mgui = Instance.new("ScreenGui")
    mgui.Name = "MXMovementDev"
    mgui.ResetOnSpawn = false
    mgui.Parent = playerGui

    local panel = Instance.new("Frame")
    panel.Name = "MovementPanel"
    panel.Size = UDim2.fromOffset(156, 178)
    panel.Position = UDim2.new(1, -166, 0.5, -89)
    panel.BackgroundColor3 = Color3.fromRGB(25, 28, 38)
    panel.BackgroundTransparency = 0.1
    panel.BorderSizePixel = 0
    panel.Parent = mgui
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 9)

    local panelTitle = Instance.new("TextLabel")
    panelTitle.Size = UDim2.new(1, -8, 0, 22)
    panelTitle.Position = UDim2.fromOffset(4, 2)
    panelTitle.BackgroundTransparency = 1
    panelTitle.Text = "MX MOVE"
    panelTitle.TextColor3 = Color3.fromRGB(235, 240, 255)
    panelTitle.Font = Enum.Font.GothamBold
    panelTitle.TextSize = 13
    panelTitle.Parent = panel

    local function button(name, text, pos, size)
        local b = Instance.new("TextButton")
        b.Name = name
        b.Text = text
        b.Position = pos
        b.Size = size
        b.BackgroundColor3 = Color3.fromRGB(55, 95, 170)
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.BorderSizePixel = 0
        b.Parent = panel
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        return b
    end

    local flyToggle = button("FlyToggle", "FLY: OFF", UDim2.fromOffset(6, 26), UDim2.new(1, -12, 0, 25))
    local noclipToggle = button("NoclipToggle", "NOCLIP: OFF", UDim2.fromOffset(6, 55), UDim2.new(1, -12, 0, 25))
    local upButton = button("Up", "▲", UDim2.fromOffset(6, 84), UDim2.new(0.5, -9, 0, 25))
    local downButton = button("Down", "▼", UDim2.new(0.5, 3, 0, 84), UDim2.new(0.5, -9, 0, 25))

    local function makeSlider(label, y, initial, callback)
        local valueLabel = Instance.new("TextLabel")
        valueLabel.Size = UDim2.new(1, -12, 0, 15)
        valueLabel.Position = UDim2.fromOffset(6, y)
        valueLabel.BackgroundTransparency = 1
        valueLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
        valueLabel.Font = Enum.Font.Gotham
        valueLabel.TextSize = 10
        valueLabel.TextXAlignment = Enum.TextXAlignment.Left
        valueLabel.Text = label .. ": " .. initial
        valueLabel.Parent = panel

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -12, 0, 8)
        bar.Position = UDim2.fromOffset(6, y + 15)
        bar.BackgroundColor3 = Color3.fromRGB(65, 70, 85)
        bar.BorderSizePixel = 0
        bar.Parent = panel
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(initial / 100, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(80, 145, 235)
        fill.BorderSizePixel = 0
        fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local hit = Instance.new("TextButton")
        hit.Size = UDim2.new(1, 0, 1, 12)
        hit.Position = UDim2.fromOffset(0, -6)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.Parent = bar

        local dragging = false
        local function setFromX(x)
            local value = math.clamp(math.floor(((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * 100 + 0.5), 1, 100)
            fill.Size = UDim2.new(value / 100, 0, 1, 0)
            valueLabel.Text = label .. ": " .. value
            callback(value)
        end
        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    makeSlider("FLY SPEED", 113, flySpeed, function(v) flySpeed = v end)
    makeSlider("WALK SPEED", 145, walkSpeed, function(v)
        walkSpeed = v
        if humanoid then humanoid.WalkSpeed = v end
    end)

    local function refreshCharacter()
        character = player.Character or player.CharacterAdded:Wait()
        humanoid = character:WaitForChild("Humanoid")
        root = character:WaitForChild("HumanoidRootPart")
        originalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = walkSpeed
    end
    refreshCharacter()

    local function stopFly()
        flying = false
        ascend, descend = false, false
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        flyToggle.Text = "FLY: OFF"
        flyToggle.BackgroundColor3 = Color3.fromRGB(55, 95, 170)
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end
    end

    local function startFly()
        if not root or not root.Parent then refreshCharacter() end
        flying = true
        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.Name = "MXVerticalFlight"
        flyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
        flyVelocity.P = 20000
        flyVelocity.Velocity = Vector3.zero
        flyVelocity.Parent = root
        flyToggle.Text = "FLY: ON"
        flyToggle.BackgroundColor3 = Color3.fromRGB(35, 150, 95)
        flyConnection = RunService.Heartbeat:Connect(function()
            if not flying or not root or not root.Parent or not flyVelocity then stopFly(); return end
            local speed = flySpeed
            local y = 0
            if ascend and not descend then y = speed
            elseif descend and not ascend then y = -speed end
            flyVelocity.Velocity = Vector3.new(0, y, 0)
        end)
    end

    local function restoreCollisions()
        for part, value in pairs(savedCollision) do
            if part and part.Parent then part.CanCollide = value end
        end
        table.clear(savedCollision)
    end

    local function stopNoclip()
        noclip = false
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
        restoreCollisions()
        noclipToggle.Text = "NOCLIP: OFF"
        noclipToggle.BackgroundColor3 = Color3.fromRGB(55, 95, 170)
    end

    local function startNoclip()
        if not character or not character.Parent then refreshCharacter() end
        noclip = true
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                savedCollision[part] = part.CanCollide
                part.CanCollide = false
            end
        end
        noclipToggle.Text = "NOCLIP: ON"
        noclipToggle.BackgroundColor3 = Color3.fromRGB(35, 150, 95)

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {character}
        rayParams.IgnoreWater = false

        noclipConnection = RunService.Heartbeat:Connect(function()
            if not noclip or not character or not character.Parent or not root then stopNoclip(); return end
            local result = workspace:Raycast(root.Position, Vector3.new(0, -18, 0), rayParams)
            if result then
                local halfHeight = math.max(2, root.Size.Y * 0.5 + 1.5)
                local safeY = result.Position.Y + halfHeight
                if root.Position.Y < safeY then
                    root.CFrame = CFrame.new(root.Position.X, safeY, root.Position.Z) * root.CFrame.Rotation
                    local vel = root.AssemblyLinearVelocity
                    if vel.Y < 0 then root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z) end
                end
            end
        end)
    end

    flyToggle.Activated:Connect(function()
        if flying then stopFly() else startFly() end
    end)
    noclipToggle.Activated:Connect(function()
        if noclip then stopNoclip() else startNoclip() end
    end)

    local function holdButton(btn, set)
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then set(true) end
        end)
        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then set(false) end
        end)
    end
    holdButton(upButton, function(v) ascend = v end)
    holdButton(downButton, function(v) descend = v end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.E then ascend = true end
        if input.KeyCode == Enum.KeyCode.Q then descend = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.E then ascend = false end
        if input.KeyCode == Enum.KeyCode.Q then descend = false end
    end)

    player.CharacterAdded:Connect(function()
        stopFly()
        stopNoclip()
        task.wait(0.2)
        refreshCharacter()
    end)
end
