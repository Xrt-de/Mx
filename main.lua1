
-- AXIOM NETWORK + POSITION HITBOX
-- Single LocalScript
-- StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local Stats = game:GetService("Stats")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local enabled = false
local currentRoot

--------------------------------------------------
-- UI
--------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "AxiomNetworkUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(260, 175)
frame.Position = UDim2.new(0, 25, 0.5, -87)
frame.BackgroundColor3 = Color3.fromRGB(17, 20, 29)
frame.BorderSizePixel = 0
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius =
    UDim.new(0, 12)

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(45, 120, 255)
stroke.Thickness = 1.5
stroke.Parent = frame

local function createLabel(name, text, y, size, color)
    local label = Instance.new("TextLabel")

    label.Name = name
    label.Size = UDim2.new(1, -20, 0, 25)
    label.Position = UDim2.fromOffset(10, y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.Font = Enum.Font.GothamMedium
    label.TextSize = size
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    return label
end

local title = createLabel(
    "Title",
    "AXIOM / NETWORK",
    8,
    14,
    Color3.fromRGB(100, 160, 255)
)

title.Font = Enum.Font.GothamBold

local pingLabel = createLabel(
    "Ping",
    "PING: -- ms",
    40,
    14,
    Color3.new(1, 1, 1)
)

local networkLabel = createLabel(
    "Network",
    "NETWORK: CONNECTING",
    68,
    12,
    Color3.fromRGB(90, 220, 140)
)

local positionLabel = createLabel(
    "Position",
    "POSITION: WAITING",
    96,
    11,
    Color3.fromRGB(180, 200, 230)
)

local toggle = Instance.new("TextButton")
toggle.Name = "HitboxToggle"
toggle.Size = UDim2.new(1, -20, 0, 35)
toggle.Position = UDim2.fromOffset(10, 130)
toggle.BackgroundColor3 = Color3.fromRGB(35, 85, 190)
toggle.Text = "HITBOX: OFF"
toggle.TextColor3 = Color3.new(1, 1, 1)
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 13
toggle.Parent = frame

Instance.new("UICorner", toggle).CornerRadius =
    UDim.new(0, 8)

--------------------------------------------------
-- POSITION BOX
--------------------------------------------------

local hitbox = Instance.new("Part")
hitbox.Name = "AxiomPositionBox"
hitbox.Anchored = true
hitbox.CanCollide = false
hitbox.CanTouch = false
hitbox.CanQuery = false
hitbox.CastShadow = false
hitbox.Material = Enum.Material.ForceField
hitbox.Color = Color3.fromRGB(0, 110, 255)
hitbox.Transparency = 0.7
hitbox.Size = Vector3.new(2, 2, 1)
hitbox.Parent = workspace

local outline = Instance.new("SelectionBox")
outline.Adornee = hitbox
outline.Color3 = Color3.fromRGB(40, 150, 255)
outline.LineThickness = 0.05
outline.SurfaceTransparency = 1
outline.Visible = false
outline.Parent = hitbox

--------------------------------------------------
-- CHARACTER TRACKING
--------------------------------------------------

local function setupCharacter(character)
    currentRoot = character:WaitForChild(
        "HumanoidRootPart",
        10
    )
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
    task.spawn(setupCharacter, player.Character)
end

--------------------------------------------------
-- TOGGLE
--------------------------------------------------

toggle.Activated:Connect(function()
    enabled = not enabled

    outline.Visible = enabled

    toggle.Text = enabled
        and "HITBOX: ON"
        or "HITBOX: OFF"

    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(20, 135, 85)
        or Color3.fromRGB(35, 85, 190)
end)

--------------------------------------------------
-- NETWORK MONITOR
--------------------------------------------------

task.spawn(function()
    while gui.Parent do
        local success, ping = pcall(function()
            return Stats.Network.ServerStatsItem[
                "Data Ping"
            ]:GetValue()
        end)

        if success and typeof(ping) == "number" then
            pingLabel.Text = string.format(
                "PING: %d ms",
                math.floor(ping)
            )

            if ping < 100 then
                networkLabel.Text = "NETWORK: STABLE"
                networkLabel.TextColor3 =
                    Color3.fromRGB(90, 220, 140)

            elseif ping < 200 then
                networkLabel.Text = "NETWORK: MODERATE"
                networkLabel.TextColor3 =
                    Color3.fromRGB(255, 190, 70)

            else
                networkLabel.Text = "NETWORK: HIGH LATENCY"
                networkLabel.TextColor3 =
                    Color3.fromRGB(255, 90, 90)
            end
        else
            pingLabel.Text = "PING: UNAVAILABLE"
            networkLabel.Text = "NETWORK: UNKNOWN"
        end

        task.wait(1)
    end
end)

--------------------------------------------------
-- POSITION UPDATE
--------------------------------------------------

RunService.RenderStepped:Connect(function()
    if not enabled or not currentRoot then
        return
    end

    if not currentRoot.Parent then
        return
    end

    hitbox.CFrame = currentRoot.CFrame
    hitbox.Size = currentRoot.Size + Vector3.new(
        0.1,
        0.1,
        0.1
    )

    local position = currentRoot.Position

    positionLabel.Text = string.format(
        "POSITION: %.1f / %.1f / %.1f",
        position.X,
        position.Y,
        position.Z
    )
end)

print("[Axiom] Network + position UI ready.")
