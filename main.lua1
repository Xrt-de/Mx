-- MX HUB v1.1
-- Roblox LocalScript
-- Unified GUI + Player/NPC Outline ESP + Player Tracers
-- Place in StarterPlayer > StarterPlayerScripts.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- SETTINGS
local ESPEnabled = false
local AimAssistEnabled = false
local AIM_SPEED = 50
local AIM_RADIUS = 180
local DUMMY_COLOR = Color3.fromRGB(255, 170, 60)

local COLOR_OPTIONS = {
    {name = "Cyan", color = Color3.fromRGB(0, 255, 255)},
    {name = "Blue", color = Color3.fromRGB(50, 120, 255)},
    {name = "White", color = Color3.fromRGB(255, 255, 255)},
    {name = "Grey", color = Color3.fromRGB(145, 145, 155)},
    {name = "Black", color = Color3.fromRGB(20, 20, 20)},
    {name = "Red", color = Color3.fromRGB(255, 55, 55)},
    {name = "Green", color = Color3.fromRGB(55, 220, 95)},
    {name = "Yellow", color = Color3.fromRGB(255, 230, 40)},
    {name = "Pink", color = Color3.fromRGB(255, 105, 180)},
    {name = "Lavender", color = Color3.fromRGB(180, 140, 255)},
    {name = "Orange", color = Color3.fromRGB(255, 150, 40)}
}

local tracerColorIndex = 2
local playerColorIndex = 2

local function getTracerColor()
    return COLOR_OPTIONS[tracerColorIndex].color
end

local function getPlayerColor()
    return COLOR_OPTIONS[playerColorIndex].color
end

local highlights = {}
local tracers = {}
local connections = {}

local oldGui = PlayerGui:FindFirstChild("MXHub")
if oldGui then
    oldGui:Destroy()
end

